### Execution Assist Visibility Logic

```javascript
function updateExecutionAssistVisibility(pageNumber, needsFixes, dimensionData) {
    const currentPage = cardContainer.querySelector(`.sprint-card-page[data-page="${pageNumber}"]`);
    const executionAssistBtn = currentPage.querySelector('.btn-execution-assist');
    const nextStepBtn = currentPage.querySelector('.btn-next-step');
    
    if (needsFixes) {
        // Health score below threshold - show Execution Assist
        executionAssistBtn.style.display = 'flex';
        nextStepBtn.disabled = true; // User must copy prompt
    } else {
        // Health score acceptable - hide Execution Assist
        executionAssistBtn.style.display = 'none';
        nextStepBtn.disabled = false; // Auto-enable, no action needed
    }
}
```

