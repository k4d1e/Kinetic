        </div>
    </div>
    
    <div class="card-footer">
        <!-- Analysis Button (for E.V.O. protocols) -->
        <div class="btn-analysis-container">
            <button class="btn-analysis" data-step="1" style="display: none;">
                Analysis
                <svg class="btn-chart-icon"><!-- Chart icon --></svg>
            </button>
