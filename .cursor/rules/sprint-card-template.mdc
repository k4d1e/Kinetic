## Initialization Sequence

**File**: `assets/js/sprintPlan.js`

```javascript
document.addEventListener('DOMContentLoaded', async () => {
    // 1. Load sprint plan card HTML
    await loadSprintPlanCard();
    
    // 2. Initialize API client
    const api = new KineticAPI();
    
    // 3. Initialize sprint circles
    initSprintCircles();
    
    // 4. Load sprint progress if property selected
    if (window.currentPropertyId) {
        await loadSprintProgress(window.currentPropertyId);
    } else {
        setDefaultSprintState(); // First circle active
    }
    
    // 5. Listen for property selection events
    window.addEventListener('propertySelected', async (event) => {
        const propertyId = event.detail.propertyId;
        await loadSprintProgress(propertyId);
    });
    
    console.log('✓ Sprint Plan system initialized');
});
```

