## Prompt Generation Router (Updated)

```javascript
generatePrompt(context) {
    const { executionInstructions, protocolKey, stepNumber,
            propertyProfile, cohortIdentity, industryIntelligence,
            bayesianIntelligence, evoData } = context;

    // Build universal sections
    const propertySection = buildPropertySection(propertyProfile, cohortIdentity);
    const constraintSection = buildConstraintSection(propertyProfile.platformConstraints);
    const bayesianSection = buildBayesianSection(bayesianIntelligence);
    const benchmarkSection = buildBenchmarkSection(bayesianIntelligence?.competitiveBenchmarks);
    const implementationSection = buildImplementationInstructions(propertyProfile, protocolKey);

    // Build protocol-specific section
    let protocolSection;
    if (executionInstructions.schemaType) {
        protocolSection = buildSchemaSection(executionInstructions, industryIntelligence, propertyProfile);
    } else if (protocolKey === 'internal_link_expansion_protocol') {
        protocolSection = buildLinkSection(executionInstructions, industryIntelligence, stepNumber);
    } else if (protocolKey === 'keyword_coverage_gap_protocol') {
        protocolSection = buildContentSection(executionInstructions, industryIntelligence, stepNumber);
    } else if (executionInstructions.dataSource) {
        protocolSection = buildAnalysisSection(executionInstructions, evoData);
    } else {
        protocolSection = buildGenericSection(executionInstructions);
    }

    // Build E.V.O. data section (existing diagnosed causes + metrics)
    const evoSection = evoData ? buildEVODataSection(evoData) : '';

    // Assemble final prompt
    return assembleMasterPrompt({
        mission: context.mission,
        stepName: context.stepName,
        stepNumber: context.stepNumber,
        propertySection,
        constraintSection,
        objective: executionInstructions.action,
        implementationFocus: executionInstructions.implementation,
        protocolSection,
        evoSection,
        bayesianSection,
        implementationSection,
        fileName: executionInstructions.deliverable || sanitizeFileName(context.stepName) + '-plan.md'
    });
}
```

