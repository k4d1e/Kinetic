## Pre-Generation Analysis

Before generating a card, E.V.O. performs pre-analysis to enrich the card with data:

### Pre-Analysis Workflow
```javascript
async function preAnalyzeBeforeCardGeneration(propertyId, cardType) {
    switch (cardType) {
        case 'meta_surgeon_protocol':
            // Pre-crawl for existing schema
            const schemaAnalysis = await analyzeExistingSchema(propertyId);
            return {
                missingSchemas: schemaAnalysis.missing,
                existingSchemas: schemaAnalysis.existing,
                priority: schemaAnalysis.priority
            };
        
        case 'gsc_indexation_protocol':
            // Pre-fetch all 4 E.V.O. dimensions
            const dimensions = ['substrate', 'crawl', 'sitemap', 'redirect'];
            const analyses = await Promise.all(
                dimensions.map(d => fetchEVODimension(d, propertyId))
            );
            return {
                substrate: analyses[0],
                crawl: analyses[1],
                sitemap: analyses[2],
                redirect: analyses[3],
                preAnalyzed: true
            };
        
        case 'internal_link_expansion_protocol':
            // Pre-build link graph
            const linkGraph = await buildLinkGraph(propertyId);
            return {
                orphanedPages: linkGraph.orphaned,
                underlinkedPages: linkGraph.underlinked,
                topOpportunities: linkGraph.opportunities.slice(0, 20)
            };
        
        case 'keyword_coverage_gap_protocol':
            // Pre-cluster keywords
            const queries = await fetchGSCQueries(propertyId);
            const clusters = await clusterKeywords(queries);
            return {
                clusters,
                topOpportunities: queries.slice(0, 50),
                totalPotential: calculateTotalOpportunity(queries)
            };
    }
}
```

