### Protocol 4: Content Opportunity Protocol

**Card Type**: `keyword_coverage_gap_protocol`

**Priority**: MEDIUM-HIGH (Growth)

**Trigger Conditions**:
```yaml
primary_triggers:
  high_impression_low_ctr:
    condition: "Keywords with >100 impressions and CTR < 50% of expected > 100"
    data_source: "GSC Search Analytics"
    severity: "high"
    weight: 100
    threshold: 100  # keyword count
    
  page_2_opportunities:
    condition: "Keywords ranking positions 11-20 with >50 impressions > 50"
    data_source: "GSC Search Analytics"
    severity: "high"
    weight: 95
    threshold: 50  # keyword count
    
  content_gaps:
    condition: "High-impression keywords with no dedicated page > 30"
    data_source: "GSC queries + site content mapping"
    severity: "medium"
    weight: 80
    threshold: 30

secondary_triggers:
  total_opportunity_volume:
    condition: "Total potential monthly clicks > 500"
    data_source: "Calculated from GSC data"
    severity: "medium"
    weight: 70
    threshold: 500  # potential monthly clicks
    
  zero_click_queries:
    condition: "Queries with >20 impressions but 0 clicks > 50"
    data_source: "GSC Search Analytics"
    severity: "low"
    weight: 40
    threshold: 50

scoring_formula: |
  score = sum(triggered_weights) / max_possible_weight * 100
  # If score > 60: Generate card
  # If score 35-60: Monitor and suggest
  # If score < 35: No action
```

**Detection Method**:
```javascript
async function detectContentOpportunityTrigger(propertyId) {
    // Fetch GSC query data (last 3 months)
    const queries = await fetchGSCQueries(propertyId, { days: 90 });
    
    let score = 0;
    const triggers = [];
    const metrics = {};
    const opportunities = [];
    
    // Categorize queries
    const lowCTROpportunities = queries.filter(q => {
        const expectedCTR = getExpectedCTRByPosition(q.position);
        return q.impressions > 100 && q.ctr < (expectedCTR * 0.5);
    });
    
    metrics.lowCTROpportunities = lowCTROpportunities.length;
    
    if (lowCTROpportunities.length > 100) {
        score += 100;
        const potentialClicks = lowCTROpportunities.reduce((sum, q) => {
            const expectedCTR = getExpectedCTRByPosition(q.position);
            return sum + (q.impressions * (expectedCTR - q.ctr));
        }, 0);
        
        triggers.push({
            type: 'high_impression_low_ctr',
            severity: 'high',
            message: `${lowCTROpportunities.length} keywords with poor CTR despite high impressions`,
            metric: lowCTROpportunities.length,
            potentialClicks: Math.round(potentialClicks),
            examples: lowCTROpportunities.slice(0, 5)
        });
    }
    
    // Page 2 quick wins
    const page2Keywords = queries.filter(q => 
        q.position >= 11 && q.position <= 20 && q.impressions > 50
    );
    
    metrics.page2QuickWins = page2Keywords.length;
    
    if (page2Keywords.length > 50) {
        score += 95;
        triggers.push({
            type: 'page_2_opportunities',
            severity: 'high',
            message: `${page2Keywords.length} keywords on page 2 (positions 11-20) ready for page 1`,
            metric: page2Keywords.length,
            examples: page2Keywords.slice(0, 5)
        });
    }
    
    // Content gaps (keywords with impressions but no dedicated page)
    const sitePages = await crawlSite(propertyId);
    const contentGaps = identifyContentGaps(queries, sitePages);
    
    metrics.contentGaps = contentGaps.length;
    
    if (contentGaps.length > 30) {
        score += 80;
        triggers.push({
            type: 'content_gaps',
            severity: 'medium',
            message: `${contentGaps.length} high-impression keywords lack dedicated pages`,
            metric: contentGaps.length,
            examples: contentGaps.slice(0, 5)
        });
    }
    
    // Calculate total opportunity
    const totalOpportunityClicks = calculateTotalOpportunity(queries);
    metrics.totalOpportunityClicks = totalOpportunityClicks;
    
    if (totalOpportunityClicks > 500) {
        score += 70;
        triggers.push({
            type: 'total_opportunity_volume',
            severity: 'medium',
            message: `${totalOpportunityClicks} potential monthly clicks identified across all opportunities`,
            metric: totalOpportunityClicks
        });
    }
    
    return {
        shouldTrigger: score >= 60,
        score,
        triggers,
        metrics,
        priority: 'medium-high',
        cardType: 'keyword_coverage_gap_protocol',
        opportunities: {
            lowCTR: lowCTROpportunities,
            page2: page2Keywords,
            contentGaps: contentGaps
        }
    };
}
```

**Dynamic Insight Generation**:
```javascript
