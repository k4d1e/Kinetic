    // In-app notification
    await createDashboardNotification(user.id, notification);
    
    // Email for critical/high priority
    if (trigger.priority === 'critical' || trigger.score >= 85) {
        await sendEmailNotification(user.email, {
            subject: `🚨 Critical SEO Issue Detected: ${trigger.cardType}`,
            body: generateEmailBody(trigger),
            actionUrl: `/dashboard/sprint-plan?card=${trigger.cardType}`
        });
    }
    
    // Slack webhook (if configured)
    if (user.slackWebhook) {
        await sendSlackNotification(user.slackWebhook, {
            text: `New Action Card: ${trigger.cardType}`,
            score: trigger.score,
            triggers: trigger.triggers.map(t => t.message)
        });
    }
}
