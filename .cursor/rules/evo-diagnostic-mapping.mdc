### Protocol 2: Index Diagnostic Protocol

**Card Type**: `gsc_indexation_protocol`

**Priority**: CRITICAL (Foundation)

**Trigger Conditions**:
```yaml
primary_triggers:
  high_exclusion_rate:
    condition: "Excluded pages > 20% of submitted pages"
    data_source: "GSC Coverage Report"
    severity: "critical"
    weight: 100
    threshold: 20  # percentage
    
  excessive_errors:
    condition: "Error pages > 50 OR error rate > 10%"
    data_source: "GSC Coverage Report (errors tab)"
    severity: "critical"
    weight: 95
    threshold: 50  # absolute count or 10% rate
    
  crawl_budget_waste:
    condition: "Server errors > 30 per day OR avg response time > 2000ms"
    data_source: "GSC Crawl Stats"
    severity: "high"
    weight: 80
    threshold: { serverErrors: 30, responseTime: 2000 }

secondary_triggers:
  sitemap_issues:
    condition: "Sitemap coverage < 70% OR sitemap has >20 errors"
    data_source: "GSC Sitemaps Report"
    severity: "medium"
    weight: 60
    threshold: { coverage: 70, errors: 20 }
    
  redirect_chains:
    condition: "Redirect chains detected > 20 URLs"
    data_source: "Site crawl + GSC Coverage"
    severity: "medium"
    weight: 50
    threshold: 20

scoring_formula: |
  score = sum(triggered_weights) / max_possible_weight * 100
  # If score > 70: Generate card immediately
  # If score 50-70: Generate card within 24 hours
  # If score < 50: Monitor only
```

**Detection Method**:
```javascript
async function detectIndexDiagnosticTrigger(propertyId) {
    const gscData = await fetchGSCData(propertyId);
    
    let score = 0;
    const triggers = [];
    const metrics = {};
    
    // Analyze Coverage Report
    const coverage = gscData.coverage;
    const totalSubmitted = coverage.valid + coverage.excluded + coverage.errors;
    const exclusionRate = (coverage.excluded / totalSubmitted) * 100;
    const errorRate = (coverage.errors / totalSubmitted) * 100;
    
    metrics.exclusionRate = exclusionRate;
    metrics.errorPages = coverage.errors;
    
    if (exclusionRate > 20) {
        score += 100;
        triggers.push({
            type: 'high_exclusion_rate',
            severity: 'critical',
            message: `${exclusionRate.toFixed(0)}% of submitted pages are excluded by Google`,
            metric: exclusionRate,
            threshold: 20
        });
    }
    
    if (coverage.errors > 50 || errorRate > 10) {
        score += 95;
        triggers.push({
            type: 'excessive_errors',
            severity: 'critical',
            message: `${coverage.errors} pages have indexation errors`,
            metric: coverage.errors,
            threshold: 50
        });
    }
    
    // Analyze Crawl Stats
    const crawlStats = gscData.crawlStats;
    const avgResponseTime = crawlStats.avgResponseTime;
    const serverErrorsPerDay = crawlStats.serverErrors / crawlStats.days;
    
    metrics.avgResponseTime = avgResponseTime;
    metrics.serverErrorsPerDay = serverErrorsPerDay;
    
    if (serverErrorsPerDay > 30 || avgResponseTime > 2000) {
        score += 80;
        triggers.push({
            type: 'crawl_budget_waste',
            severity: 'high',
            message: `Crawl budget wasted: ${serverErrorsPerDay.toFixed(0)} errors/day, ${avgResponseTime}ms avg response`,
            metrics: { serverErrorsPerDay, avgResponseTime }
        });
    }
    
    // Analyze Sitemaps
    const sitemaps = gscData.sitemaps;
    const sitemapCoverage = (sitemaps.indexed / sitemaps.submitted) * 100;
    
    metrics.sitemapCoverage = sitemapCoverage;
    
    if (sitemapCoverage < 70 || sitemaps.errors > 20) {
        score += 60;
        triggers.push({
            type: 'sitemap_issues',
            severity: 'medium',
            message: `Sitemap health poor: ${sitemapCoverage.toFixed(0)}% coverage, ${sitemaps.errors} errors`,
            metrics: { coverage: sitemapCoverage, errors: sitemaps.errors }
        });
    }
    
    return {
        shouldTrigger: score >= 70,
        score,
        triggers,
        metrics,
        priority: 'critical',
        cardType: 'gsc_indexation_protocol',
        urgency: score >= 90 ? 'immediate' : 'high'
    };
}
```

**Dynamic Insight Generation**:
```javascript
function generateIndexDiagnosticInsight(triggers, metrics, propertyName) {
    const { exclusionRate, errorPages, serverErrorsPerDay } = metrics;
    
    // Critical: High exclusion rate
    if (exclusionRate > 30) {
        return `Your indexation is bleeding. Google is rejecting ${exclusionRate.toFixed(0)}% of your submitted pages—that's ${errorPages} URLs that should be ranking but are invisible. Every excluded page is lost traffic, lost leads, lost revenue. This is a site emergency. Let's diagnose and fix the foundation before optimizing anything else.`;
    }
    
    // High: Crawl budget waste
    if (serverErrorsPerDay > 50) {
        return `Googlebot is hitting ${serverErrorsPerDay.toFixed(0)} server errors per day on ${propertyName}. Your crawl budget is being burned on broken requests instead of discovering your valuable pages. While competitors get fresh crawls, you're wasting yours on dead ends. Let's redirect the crawler's attention.`;
    }
    
    // Medium: General indexation issues
    if (exclusionRate > 20) {
        return `Google's crawlers visit your site daily, but are they wasting time on broken pages or focusing on your money-makers? Right now, ${exclusionRate.toFixed(0)}% of your pages are excluded, googlebot might be burning crawl budget on redirect chains, duplicate content, and 404 black holes. Let's audit the raw GSC data and redirect their attention to pages that convert.`;
    }
    
    // Default insight
    return `Your GSC data shows indexation inefficiencies costing you traffic. Let's analyze coverage, crawl stats, sitemaps, and redirects to ensure Google is crawling and indexing the right pages.`;
}
