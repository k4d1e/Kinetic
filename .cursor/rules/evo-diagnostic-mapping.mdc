### Protocol 3: Link Architecture Protocol

**Card Type**: `internal_link_expansion_protocol`

**Priority**: HIGH (Optimization)

**Trigger Conditions**:
```yaml
primary_triggers:
  excessive_orphaned_pages:
    condition: "Orphaned pages (0 internal links) > 30"
    data_source: "Site crawl analysis"
    severity: "high"
    weight: 100
    threshold: 30
    
  underlinked_money_pages:
    condition: "High-value pages with < 3 internal links > 10"
    data_source: "Site crawl + conversion page identification"
    severity: "high"
    weight: 90
    threshold: 10
    
  poor_link_distribution:
    condition: "Top 10% of pages receive > 60% of all internal links"
    data_source: "Link graph analysis"
    severity: "medium"
    weight: 70
    threshold: 60  # percentage concentration

secondary_triggers:
  high_link_depth:
    condition: "Pages requiring > 4 clicks from homepage > 20%"
    data_source: "Site crawl depth analysis"
    severity: "medium"
    weight: 60
    threshold: { depth: 4, percentage: 20 }
    
  weak_topical_clusters:
    condition: "Topical clusters with < 50% internal connections"
    data_source: "Content clustering + link analysis"
    severity: "medium"
    weight: 50
    threshold: 50  # percentage interconnected

scoring_formula: |
  score = sum(triggered_weights) / max_possible_weight * 100
  # If score > 65: Generate card
  # If score 40-65: Suggest in recommendations
  # If score < 40: No action
```

**Detection Method**:
```javascript
async function detectLinkArchitectureTrigger(siteUrl) {
    // Crawl site and build link graph
    const crawlResults = await crawlSite(siteUrl, { maxPages: 500 });
    const linkGraph = buildLinkGraph(crawlResults);
    
    let score = 0;
    const triggers = [];
    const metrics = {};
    
    // Find orphaned pages
    const orphanedPages = linkGraph.nodes.filter(page => page.incomingLinks === 0);
    metrics.orphanedPages = orphanedPages.length;
    
    if (orphanedPages.length > 30) {
        score += 100;
        triggers.push({
            type: 'excessive_orphaned_pages',
            severity: 'high',
            message: `${orphanedPages.length} pages have zero incoming internal links`,
            metric: orphanedPages.length,
            threshold: 30,
            urls: orphanedPages.map(p => p.url).slice(0, 10)
        });
    }
    
    // Identify high-value pages (money pages)
    const moneyPages = identifyMoneyPages(crawlResults);
    const underlinkedMoneyPages = moneyPages.filter(page => {
        const incomingLinks = linkGraph.getIncomingLinks(page.url);
        return incomingLinks < 3;
    });
    
    metrics.underlinkedMoneyPages = underlinkedMoneyPages.length;
    
    if (underlinkedMoneyPages.length > 10) {
        score += 90;
        triggers.push({
            type: 'underlinked_money_pages',
            severity: 'high',
            message: `${underlinkedMoneyPages.length} high-value pages have < 3 internal links`,
            metric: underlinkedMoneyPages.length,
            urls: underlinkedMoneyPages.map(p => p.url)
        });
    }
    
    // Analyze link distribution
    const totalLinks = linkGraph.edges.length;
    const sortedByIncoming = linkGraph.nodes.sort((a, b) => b.incomingLinks - a.incomingLinks);
    const top10Percent = Math.ceil(sortedByIncoming.length * 0.1);
    const linksToTop10 = sortedByIncoming.slice(0, top10Percent)
        .reduce((sum, page) => sum + page.incomingLinks, 0);
    const concentration = (linksToTop10 / totalLinks) * 100;
    
    metrics.linkConcentration = concentration;
    
    if (concentration > 60) {
        score += 70;
        triggers.push({
            type: 'poor_link_distribution',
            severity: 'medium',
            message: `${concentration.toFixed(0)}% of internal links concentrated in top 10% of pages`,
            metric: concentration,
            threshold: 60
        });
    }
    
    return {
        shouldTrigger: score >= 65,
        score,
        triggers,
        metrics,
        priority: 'high',
        cardType: 'internal_link_expansion_protocol'
    };
}
```

**Dynamic Insight Generation**:
```javascript
function generateLinkArchitectureInsight(triggers, metrics, companyName) {
    const { orphanedPages, underlinkedMoneyPages, linkConcentration } = metrics;
    
    // Critical: Many orphaned pages
    if (orphanedPages > 50) {
        return `${companyName} has ${orphanedPages} orphaned pages—content that Google and users can barely find. These isolated pages are bleeding potential traffic because they're not connected to your site's link architecture. You've created content, but buried it. Let's build strategic pathways to make these pages discoverable.`;
    }
    
    // High: Money pages underlinked
    if (underlinkedMoneyPages > 15) {
        return `Your ${underlinkedMoneyPages} highest-value pages—the ones that drive conversions—have almost no internal links pointing to them. You're hiding your best products. Meanwhile, your blog posts are hoarding all the link authority. Let's redistribute link equity to the pages that matter.`;
    }
    
    // Medium: Poor distribution
    if (linkConcentration > 70) {
        return `${linkConcentration.toFixed(0)}% of your internal links are concentrated in just 10% of your pages. This creates authority deserts—valuable pages starved for link equity while others are oversaturated. Let's balance the link distribution to amplify your entire site.`;
    }
    
    // Default insight
    return `Internal links are the pathways that distribute authority and guide users through your site. Right now, you might have orphaned pages, weak topical signals, and missed opportunities to connect high-value content. Let's architect a strategic linking system that amplifies authority and enhances user experience.`;
}
```

